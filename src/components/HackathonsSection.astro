---
const hackathons = [
  {
    name: "NVIDIA Nemotron Model Reasoning Challenge",
    event: "Kaggle Competition",
    date: "June 2026",
    achievement: "Bronze Medal — 237th / 4182",
    achievementIcon: "🥉",
    description: "Competed in the NVIDIA Nemotron Model Reasoning Challenge on Kaggle, placing 237th out of 4,182 teams. Earned a Bronze Medal for developing solutions to evaluate and improve reasoning capabilities of NVIDIA's Nemotron models.",
    tech: ["Python", "NVIDIA Nemotron", "Kaggle", "ML Reasoning"],
    certImage: `${import.meta.env.BASE_URL}certificates/nvidia-nemotron.png`,
  },
  {
    name: "PyTorch X Meta Hackathon",
    event: "Scaler School of Technology",
    date: "2025",
    achievement: "Participant",
    achievementIcon: "🔥",
    description: "Participated in the PyTorch X Meta Hackathon organized by Scaler School of Technology. Built deep learning solutions using PyTorch and Meta's AI frameworks.",
    tech: ["PyTorch", "Meta AI", "Deep Learning", "Python"],
    certPdf: `${import.meta.env.BASE_URL}certificates/pytorch-meta.pdf`,
  },
];
---

<section id="hackathons" class="relative py-24 md:py-32">
  <div class="absolute inset-0 mesh-gradient opacity-20 pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="mb-12 md:mb-16 reveal">
      <span class="text-xs font-semibold uppercase tracking-[0.2em] text-accent mb-3 block font-mono">
        Compete
      </span>
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight text-ink">
        Hackathons.
      </h2>
    </div>

    <!-- Timeline layout -->
    <div class="relative">
      <!-- Vertical timeline line (desktop) -->
      <div class="hidden md:block absolute left-6 top-0 bottom-0 w-px bg-gradient-to-b from-accent/30 via-hairline to-transparent"></div>

      <div class="space-y-6 md:space-y-8">
        {hackathons.map((hackathon, hackIndex) => (
          <div class={`reveal reveal-delay-${Math.min(hackIndex + 1, 5)} relative`}>
            {/* Timeline dot (desktop) */}
            <div class="hidden md:flex absolute left-6 top-6 -translate-x-1/2 w-3 h-3 rounded-full bg-accent border-2 border-canvas z-10"></div>

            <div class="md:ml-14 rounded-2xl bg-canvas-elevated border border-hairline/50 p-5 sm:p-6 transition-all duration-300 hover:border-accent/30 hover:shadow-[0_4px_24px_rgba(124,58,237,0.1)] group/hack hover-lift">
              {/* Header row */}
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-4">
                <div class="flex items-start gap-3">
                  <span class="text-2xl shrink-0 mt-0.5">{hackathon.achievementIcon}</span>
                  <div>
                    <h3 class="font-semibold text-base text-ink mb-0.5">
                      {hackathon.name}
                    </h3>
                    <p class="text-xs text-muted">
                      {hackathon.event} · {hackathon.date}
                    </p>
                  </div>
                </div>
                <span class="self-start px-3 py-1 text-[11px] font-semibold font-mono rounded-lg bg-accent/15 text-accent border border-accent/20 whitespace-nowrap">
                  {hackathon.achievement}
                </span>
              </div>

              {/* Description */}
              <p class="text-sm text-body leading-relaxed mb-4">
                {hackathon.description}
              </p>

              {/* Tech stack */}
              <div class="flex flex-wrap gap-1.5 mb-4">
                {hackathon.tech.map((tech) => (
                  <span class="px-2.5 py-0.5 text-[10px] font-medium font-mono rounded-md bg-accent/10 text-accent/80 border border-accent/10 hover:bg-accent/15 transition-colors duration-200">
                    {tech}
                  </span>
                ))}
              </div>

              {/* Certificate link */}
              {(hackathon.certImage || hackathon.certPdf) && (
                <button
                  type="button"
                  data-hack-cert-trigger
                  data-hack-cert-pdf={hackathon.certPdf || ""}
                  data-hack-cert-image={hackathon.certImage || ""}
                  data-hack-cert-title={hackathon.name}
                  class="inline-flex items-center gap-1.5 text-[11px] font-medium text-accent hover:underline cursor-pointer"
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
                    <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
                  </svg>
                  View Certificate
                </button>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- Section divider -->
<div class="section-separator"></div>

<!-- Certificate Modal Viewer -->
<div id="hack-cert-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-canvas/80 backdrop-blur-md p-4 sm:p-8">
  <div class="relative w-full max-w-5xl h-[80vh] rounded-2xl bg-canvas-elevated border border-hairline/50 overflow-hidden shadow-2xl flex flex-col">
    <div class="flex items-center justify-between px-5 py-3 border-b border-hairline/50 shrink-0">
      <h3 id="hack-cert-modal-title" class="text-sm font-semibold text-ink truncate pr-4"></h3>
      <button id="hack-cert-modal-close" class="p-1.5 rounded-lg text-muted hover:text-ink hover:bg-surface transition-all" aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6 6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div id="hack-cert-modal-content" class="flex-1 overflow-auto p-4 flex items-center justify-center bg-surface/50"></div>
  </div>
</div>

<script>
  const hackModal = document.getElementById("hack-cert-modal")!;
  const hackModalTitle = document.getElementById("hack-cert-modal-title")!;
  const hackModalContent = document.getElementById("hack-cert-modal-content")!;
  const hackCloseBtn = document.getElementById("hack-cert-modal-close")!;

  function openHackCertModal(title: string, pdfPath: string, imagePath: string) {
    hackModalTitle.textContent = title;
    hackModalContent.innerHTML = "";
    if (pdfPath) {
      const iframe = document.createElement("iframe");
      iframe.src = pdfPath;
      iframe.className = "w-full h-full rounded-lg border-0";
      iframe.title = title;
      hackModalContent.appendChild(iframe);
    } else if (imagePath) {
      const img = document.createElement("img");
      img.src = imagePath;
      img.alt = title;
      img.className = "max-w-full max-h-full object-contain rounded-lg";
      hackModalContent.appendChild(img);
    }
    hackModal.classList.remove("hidden");
    hackModal.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function closeHackCertModal() {
    hackModal.classList.add("hidden");
    hackModal.classList.remove("flex");
    hackModalContent.innerHTML = "";
    document.body.style.overflow = "";
  }

  document.querySelectorAll("[data-hack-cert-trigger]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const title = btn.getAttribute("data-hack-cert-title") || "";
      const pdfPath = btn.getAttribute("data-hack-cert-pdf") || "";
      const imagePath = btn.getAttribute("data-hack-cert-image") || "";
      openHackCertModal(title, pdfPath, imagePath);
    });
  });

  hackCloseBtn.addEventListener("click", closeHackCertModal);
  hackModal.addEventListener("click", (e) => { if (e.target === hackModal) closeHackCertModal(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeHackCertModal(); });
</script>
