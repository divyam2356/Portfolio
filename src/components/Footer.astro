      <!-- Brand column -->
      <div class="reveal">
        <a href={import.meta.env.BASE_URL} class="text-lg font-semibold tracking-tight inline-block mb-4">
          <span class="gradient-text">D</span><span class="text-ink">ivyam</span><span class="text-accent">S</span><span class="text-ink">ingh</span>
        </a>
        <p class="text-sm text-body leading-relaxed max-w-xs">
          Full Stack AI Developer building the future with Transformer architectures and agentic systems.
        </p>
      </div>

