---
import { projects } from "../data/projects";
---

<section id="projects" class="relative py-24 md:py-32">
  <div class="absolute inset-0 mesh-gradient opacity-30 pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="mb-12 md:mb-16 reveal">
      <span class="text-xs font-semibold uppercase tracking-[0.2em] text-accent mb-3 block font-mono">
        Portfolio
      </span>
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight text-ink">
        Featured projects.
      </h2>
    </div>

    <div class="reveal reveal-delay-1">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
        {projects.map((project) => (
          <a
            href={`${import.meta.env.BASE_URL}projects/${project.slug}`}
            class="project-card group/card hover-lift"
          >
              <div class="relative rounded-xl overflow-hidden bg-canvas-elevated border border-hairline/50 transition-all duration-500 group-hover/card:border-accent/30 group-hover/card:shadow-[0_8px_40px_rgba(124,58,237,0.12)] h-full flex flex-col card-glow">
              {/* Thumbnail */}
              <div class="relative aspect-video overflow-hidden bg-surface">
                <div class="absolute inset-0 bg-gradient-to-br from-accent/15 via-accent/5 to-transparent"></div>
                <div class="absolute inset-0 flex items-center justify-center">
                  <span class="text-4xl font-semibold gradient-text opacity-20">
                    {project.title.charAt(0)}
                  </span>
                </div>
                <div class="absolute inset-0 bg-gradient-to-t from-canvas-elevated via-transparent to-transparent opacity-60 group-hover/card:opacity-90 transition-opacity duration-300"></div>
              </div>

              {/* Card content */}
              <div class="p-4 sm:p-5 flex flex-col flex-1">
                <h3 class="font-semibold text-sm text-ink mb-2 line-clamp-1">
                  {project.title}
                </h3>
                <p class="text-xs text-muted mb-3 line-clamp-2">
                  {project.shortDescription}
                </p>
                <div class="flex flex-wrap gap-1.5 mt-auto">
                  {project.techStack.slice(0, 3).map((tech) => (
                    <span class="px-2 py-0.5 text-[10px] font-medium font-mono rounded-md bg-accent/10 text-accent/80 border border-accent/10">
                      {tech}
                    </span>
                  ))}
                  {project.techStack.length > 3 && (
                    <span class="px-2 py-0.5 text-[10px] font-medium font-mono rounded-md bg-surface text-muted">
                      +{project.techStack.length - 3}
                    </span>
                  )}
                </div>
              </div>

              {/* Hover overlay */}
              <div class="absolute inset-0 bg-canvas-elevated/95 backdrop-blur-sm rounded-xl flex flex-col justify-end p-5 opacity-0 group-hover/card:opacity-100 transition-all duration-300 pointer-events-none group-hover/card:pointer-events-auto">
                <p class="text-xs text-body mb-3 line-clamp-3">
                  {project.shortDescription}
                </p>
                <div class="flex flex-wrap gap-1.5 mb-4">
                  {project.techStack.map((tech) => (
                    <span class="px-2 py-0.5 text-[10px] font-medium font-mono rounded-md bg-accent/10 text-accent border border-accent/20">
                      {tech}
                    </span>
                  ))}
                </div>
                <div class="flex items-center gap-3">
                  {project.github && (
                    <span class="flex items-center gap-1.5 text-xs text-body hover:text-accent transition-colors">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                      Code
                    </span>
                  )}
                  <span class="ml-auto text-[11px] font-medium text-accent">
                    View Details →
                  </span>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- Section divider -->
<div class="section-separator"></div>
