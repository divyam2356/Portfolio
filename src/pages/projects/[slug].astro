---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} — Divyam Singh`}>
  <Navbar />

  <main class="pt-24 pb-20 md:pt-28 md:pb-28">
    <div class="max-w-4xl mx-auto px-5 sm:px-6 lg:px-8">
      <!-- Back link -->
      <a
        href={`${import.meta.env.BASE_URL}#projects`}
        class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-accent transition-colors mb-8 sm:mb-10"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        Back to projects
      </a>

      <!-- Header -->
      <header class="mb-10 sm:mb-14">
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class="px-2.5 py-0.5 text-[11px] font-medium font-mono rounded-lg bg-accent/10 text-accent border border-accent/10">
            {project.category}
          </span>
          {project.is_featured && (
            <span class="px-2.5 py-0.5 text-[11px] font-medium font-mono rounded-lg bg-accent/15 text-accent border border-accent/20">
              Featured
            </span>
          )}
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight text-ink mb-4">
          {project.title}
        </h1>
        <p class="text-base sm:text-lg text-body leading-relaxed max-w-2xl">
          {project.shortDescription}
        </p>
      </header>

      <!-- Thumbnail -->
      <div class="relative aspect-video rounded-2xl overflow-hidden bg-canvas-elevated border border-hairline/50 mb-10 sm:mb-14">
        <div class="absolute inset-0 bg-gradient-to-br from-accent/15 via-accent/5 to-transparent"></div>
        <div class="absolute inset-0 flex items-center justify-center">
          <span class="text-6xl sm:text-7xl font-semibold gradient-text opacity-15">
            {project.title.charAt(0)}
          </span>
        </div>
      </div>

      <!-- Content -->
      <article class="prose prose-invert max-w-none mb-10 sm:mb-14">
        <div class="space-y-6">
          <div class="rounded-2xl bg-canvas-elevated border border-hairline/50 p-5 sm:p-7">
            <h2 class="text-lg sm:text-xl font-semibold text-ink mb-4">Overview</h2>
            <p class="text-sm sm:text-base text-body leading-relaxed">
              {project.shortDescription}
            </p>
          </div>

          {project.fullDescription && (
            <div class="rounded-2xl bg-canvas-elevated border border-hairline/50 p-5 sm:p-7">
              <h2 class="text-lg sm:text-xl font-semibold text-ink mb-4">Details</h2>
              <p class="text-sm sm:text-base text-body leading-relaxed">
                {project.fullDescription}
              </p>
            </div>
          )}

          {project.impact && (
            <div class="rounded-2xl bg-canvas-elevated border border-hairline/50 p-5 sm:p-7">
              <h2 class="text-lg sm:text-xl font-semibold text-ink mb-4">Impact</h2>
              <ul class="space-y-2">
                {project.impact.map((item) => (
                  <li class="flex items-start gap-2.5 text-sm sm:text-base text-body">
                    <span class="text-accent mt-1 shrink-0">▸</span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </article>

      <!-- Tech stack -->
      <div class="mb-10 sm:mb-14">
        <h2 class="text-lg sm:text-xl font-semibold text-ink mb-4">Tech Stack</h2>
        <div class="flex flex-wrap gap-2">
          {project.techStack.map((tech) => (
            <span class="px-3 py-1.5 text-xs font-medium font-mono rounded-lg bg-accent/10 text-accent border border-accent/10">
              {tech}
            </span>
          ))}
        </div>
      </div>

      <!-- Links -->
      <div class="flex flex-wrap gap-3">
        {project.github && (
          <a
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-medium bg-ink text-canvas hover:bg-ink/90 transition-colors"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            View Code
          </a>
        )}
        {project.liveDemo && (
          <a
            href={project.liveDemo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-medium border border-hairline text-body hover:border-accent/50 hover:text-accent hover:bg-accent/5 transition-all"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
            Live Demo
          </a>
        )}
      </div>
    </div>
  </main>

  <Footer />
</Layout>
