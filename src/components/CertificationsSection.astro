---
interface Certification {
  title: string;
  issuer: string;
  description: string;
  pdfPath?: string;
  imagePath?: string;
  verified: boolean;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const certifications: Certification[] = [
  {
    title: "Oracle Cloud Infrastructure — Generative AI Certified Professional",
    issuer: "Oracle · Generative AI",
    description: "Covers OCI generative AI services, LLM deployment, fine-tuning strategies, and production-scale AI infrastructure on Oracle Cloud.",
    pdfPath: `${base}/certificates/eCertificate.pdf`,
    verified: true,
  },
];
---

<section class="relative py-24 md:py-32">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="mb-12 md:mb-16 reveal">
      <span class="text-xs font-semibold uppercase tracking-[0.2em] text-accent mb-3 block font-mono">
        Credentials
      </span>
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight text-ink">
        Certifications.
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
      {certifications.map((cert, certIndex) => (
        <button
          type="button"
          data-cert-trigger
          data-cert-pdf={cert.pdfPath || ""}
          data-cert-image={cert.imagePath || ""}
          data-cert-title={cert.title}
          class={`reveal reveal-delay-${Math.min(certIndex + 1, 4)} relative rounded-2xl bg-canvas-elevated border border-hairline/50 p-5 sm:p-6 overflow-hidden group/cert transition-all duration-300 hover:border-accent/30 hover:shadow-[0_4px_24px_rgba(124,58,237,0.1)] text-left cursor-pointer w-full hover-lift`}
        >
          <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-bl from-accent/8 to-transparent rounded-bl-full"></div>
          <div class="relative">
            <div class="flex items-start justify-between mb-4">
              <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-accent/20 to-accent/5 flex items-center justify-center border border-accent/10">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-accent">
                  <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5C7 4 9 7 12 7s5-3 7.5-3a2.5 2.5 0 0 1 0 5H18"/>
                  <path d="m14 5-2 2-2-2"/>
                  <path d="M12 7v12"/>
                  <path d="M8 15h8"/>
                </svg>
              </div>
              {cert.verified && (
                <span class="px-2 py-0.5 text-[10px] font-semibold font-mono rounded-md bg-accent/10 text-accent border border-accent/10">
                  Verified
                </span>
              )}
            </div>
            <h3 class="font-semibold text-sm text-ink mb-1.5 pr-4 leading-snug">
              {cert.title}
            </h3>
            <p class="text-xs text-body mb-3">
              {cert.issuer}
            </p>
            <p class="text-xs text-muted leading-relaxed mb-3">
              {cert.description}
            </p>
            <span class="inline-flex items-center gap-1.5 text-[11px] font-medium text-accent group-hover/cert:underline">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
                <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
              </svg>
              View Certificate
            </span>
          </div>
        </button>
      ))}
    </div>
  </div>
</section>

<!-- Certificate Modal Viewer -->
<div id="cert-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-canvas/80 backdrop-blur-md p-3 sm:p-6">
  <div class="relative w-full max-w-5xl h-[85vh] rounded-2xl bg-canvas-elevated border border-hairline/50 overflow-hidden shadow-2xl flex flex-col">
    <!-- Modal header -->
    <div class="flex items-center justify-between px-5 py-3.5 border-b border-hairline/50 shrink-0 bg-canvas-elevated z-10">
      <h3 id="cert-modal-title" class="text-sm font-semibold text-ink truncate pr-4"></h3>
      <div class="flex items-center gap-2">
        <a id="cert-modal-open-new" href="#" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium rounded-lg bg-accent/15 text-accent border border-accent/20 hover:bg-accent/25 transition-all">
          Open in New Tab ↗
        </a>
        <button id="cert-modal-close" class="p-1.5 rounded-lg text-muted hover:text-ink hover:bg-surface transition-all" aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6 6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
    <!-- Modal content -->
    <div id="cert-modal-content" class="flex-1 w-full h-full p-2 sm:p-4 flex items-center justify-center bg-surface/50 overflow-hidden">
      <!-- PDF object or image will be injected here -->
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById("cert-modal")!;
  const modalTitle = document.getElementById("cert-modal-title")!;
  const modalContent = document.getElementById("cert-modal-content")!;
  const openNewBtn = document.getElementById("cert-modal-open-new") as HTMLAnchorElement;
  const closeBtn = document.getElementById("cert-modal-close")!;

  function openCertModal(title: string, pdfPath: string, imagePath: string) {
    modalTitle.textContent = title;
    modalContent.innerHTML = "";
    const activePath = pdfPath || imagePath;
    if (openNewBtn) {
      openNewBtn.href = activePath;
    }

    if (pdfPath) {
      const objectEl = document.createElement("object");
      objectEl.data = pdfPath;
      objectEl.type = "application/pdf";
      objectEl.className = "w-full h-full rounded-lg border-0 min-h-[400px]";
      objectEl.innerHTML = `
        <div class="flex flex-col items-center justify-center h-full p-6 text-center bg-canvas-elevated rounded-xl border border-hairline/50 max-w-md mx-auto">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-accent mb-3">
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
            <polyline points="14 2 14 8 20 8"/>
          </svg>
          <p class="text-sm text-body font-medium mb-1">Viewing Certificate PDF</p>
          <p class="text-xs text-muted mb-4">If the preview does not display automatically in your browser:</p>
          <a href="${pdfPath}" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-full text-xs font-semibold bg-accent text-white hover:bg-accent/90 transition-colors shadow-lg">
            Open PDF in New Tab ↗
          </a>
        </div>
      `;
      modalContent.appendChild(objectEl);
    } else if (imagePath) {
      const img = document.createElement("img");
      img.src = imagePath;
      img.alt = title;
      img.className = "max-w-full max-h-full object-contain rounded-lg shadow-xl";
      modalContent.appendChild(img);
    }

    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function closeCertModal() {
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    modalContent.innerHTML = "";
    document.body.style.overflow = "";
  }

  // Attach click handlers to cert cards
  document.querySelectorAll("[data-cert-trigger]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const title = btn.getAttribute("data-cert-title") || "";
      const pdfPath = btn.getAttribute("data-cert-pdf") || "";
      const imagePath = btn.getAttribute("data-cert-image") || "";
      openCertModal(title, pdfPath, imagePath);
    });
  });

  // Close button
  closeBtn.addEventListener("click", closeCertModal);

  // Click outside to close
  modal.addEventListener("click", (e) => {
    if (e.target === modal) closeCertModal();
  });

  // Escape key to close
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeCertModal();
  });
</script>
